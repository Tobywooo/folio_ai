# Folio AI configuration template.
# Copy this file to `.env` (which is gitignored) and fill in the values.
# For the deployed Function App, enter the same names under
#   Function App -> Settings -> Environment variables -> App settings
# and for GitHub Actions, store secrets under Repo -> Settings -> Secrets and variables -> Actions.
# Never commit real keys.

# ---------------------------------------------------------------------------
# Azure Storage account (notebook data, raw sources, enriched sources, artifacts)
# Portal: Storage account -> Security + networking -> Access keys -> Connection string
# ---------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=

# Blob containers. Defaults match the containers already created; change only if renamed.
CONTAINER_PDF=pdf-documents
CONTAINER_PDF_ENRICHED=pdf-documents-enriched
CONTAINER_PPTX=pptx-files
CONTAINER_PPTX_ENRICHED=pptx-files-enriched
CONTAINER_TXT=txt-files
CONTAINER_TXT_ENRICHED=txt-files-enriched
CONTAINER_WEB=web-scraped
CONTAINER_WEB_ENRICHED=web-scraped-enriched
# Generated reports/quizzes (.md). Created automatically if missing.
CONTAINER_ARTIFACTS=artifacts

# Table storage (notebooks, sources, chat messages, artifact metadata).
# Created automatically if missing. Prefix lets you run separate environments in one account.
TABLE_PREFIX=folio

# ---------------------------------------------------------------------------
# Azure AI Search (vector + keyword index)
# Portal: Search service -> Overview -> Url        (endpoint)
#         Search service -> Settings -> Keys       (use an ADMIN key: the backend writes to the index)
# ---------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://rg-folio-ai-search-service.search.windows.net
AZURE_SEARCH_API_KEY=
# Created automatically on first run. If you change the embedding model (and its
# dimensions), use a NEW index name - vector dimensions can't change on an existing index.
AZURE_SEARCH_INDEX_NAME=folio-chunks

# ---------------------------------------------------------------------------
# LLM (Llama) - must expose an OpenAI-compatible  POST {base_url}/chat/completions
# Example base URL for Meta's Llama API compatibility endpoint: https://api.llama.com/compat/v1
# ---------------------------------------------------------------------------
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ---------------------------------------------------------------------------
# Embedding model - must expose an OpenAI-compatible  POST {base_url}/embeddings
# Can be the same base URL as the LLM with a different key.
# EMBEDDING_DIMENSIONS must match the length of the vectors the model returns
# (check the model's docs, e.g. 768 / 1024 / 4096).
# ---------------------------------------------------------------------------
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
# Texts per embeddings request. Lower it if the API rejects large batches.
EMBEDDING_BATCH_SIZE=16

# ---------------------------------------------------------------------------
# Ingestion / retrieval tuning
# ---------------------------------------------------------------------------
# Characters per chunk and characters of overlap between neighbouring chunks.
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
# Max upload size per file, in MB.
MAX_UPLOAD_MB=25
# Default retrieval mode: keyword | vector | hybrid | hybrid_semantic
# (hybrid_semantic requires the semantic ranker to be enabled on the Search service)
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=5
# Previous chat turns sent to the LLM for follow-up questions.
CHAT_HISTORY_TURNS=6
# Max characters of source text fed to the LLM when generating a report or quiz.
ARTIFACT_CONTEXT_CHARS=24000

# ---------------------------------------------------------------------------
# Gradio UI -> Function App connection
# Local:    http://localhost:7071/api
# Deployed: https://<function-app-name>.azurewebsites.net/api
# Key:      Function App -> Functions -> App keys -> default   (leave blank for local `func start`)
# ---------------------------------------------------------------------------
BACKEND_URL=http://localhost:7071/api
BACKEND_FUNCTION_KEY=

# Optional basic login for the Gradio UI (recommended once deployed publicly).
UI_USERNAME=
UI_PASSWORD=
